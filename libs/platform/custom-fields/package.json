{
  "name": "@sms/custom-fields",
  "version": "0.0.0",
  "private": true,
  "description": "Tenant-defined custom fields: a field definition catalogue per (tenant, entity type), compiled to a cached Zod schema. Values are never stored here - see the module's migration header for why entity-attribute-value tables are rejected.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "tags": [
      "type:platform"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sms/kernel": "workspace:*",
    "@sms/db": "workspace:*",
    "@sms/tenancy": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@nestjs/swagger": "^11.4.6",
    "nestjs-zod": "^5.5.0"
  },
  "devDependencies": {
    "@nestjs/swagger": "^11.4.6",
    "@testcontainers/postgresql": "^12.1.0",
    "nestjs-zod": "^5.5.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.11"
  }
}
