{
  "name": "@sms/notifications",
  "version": "0.0.0",
  "private": true,
  "description": "Turns a domain fact into a message a person actually gets: templates, per-recipient/per-channel consent and delivery tracking, and the attendance.marked_absent -> guardian email loop. See the 1300 migration header.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "tags": [
      "type:platform"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sms/kernel": "workspace:*",
    "@sms/db": "workspace:*",
    "@sms/audit": "workspace:*",
    "@sms/outbox": "workspace:*",
    "@sms/access": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "rxjs": "^7.8.2",
    "nodemailer": "^9.0.5"
  },
  "peerDependencies": {
    "@nestjs/swagger": "^11.4.6",
    "nestjs-zod": "^5.5.0"
  },
  "devDependencies": {
    "@nestjs/swagger": "^11.4.6",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/nodemailer": "^8.0.1",
    "nestjs-zod": "^5.5.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.11"
  }
}
