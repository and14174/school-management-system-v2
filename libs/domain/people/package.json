{
  "name": "@sms/people",
  "version": "0.0.0",
  "private": true,
  "description": "One person, one record: the core person registry (roles, households, relationships, identifiers, alerts) plus duplicate detection and merge.",
  "type": "module",
  "main": "./src/index.ts",
