strict-peer-dependencies=false
auto-install-peers=true
save-exact=false

# One physical copy of every package, npm-style flat node_modules.
#
# pnpm's default isolated linker hashes a package's directory by its resolved
# peer context, so apps/api and libs/platform/* ended up with DIFFERENT physical
# copies of @nestjs/common and @nestjs/core despite identical versions. That
# breaks anything relying on class identity across the boundary:
#   * `instanceof HttpException` failed, turning 400s into 500s
#   * injecting Nest's `Reflector` failed to resolve at boot
# This is an application monorepo, not a published library, so the phantom-
# dependency risk that isolated mode guards against is not worth those costs.
