# Copy to .env for local development. Nothing here is secret.

# --- Database -----------------------------------------------------------
# The API connects as sms_app (RLS applies). Migrations run as sms_owner.
DATABASE_URL=postgres://sms_app:dev@localhost:5432/sms
DATABASE_MIGRATION_URL=postgres://sms_owner:dev@localhost:5432/sms

# --- Cache and queues ---------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO locally, S3/R2 in production) ----------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sms-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Mail (Mailpit catches everything locally) --------------------------
SMTP_URL=smtp://localhost:1025
MAIL_FROM="School Management System <no-reply@localhost>"

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-value

# --- URLs ---------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:3333

# --- Provider adapters --------------------------------------------------
# "console" writes to stdout instead of calling a real provider.
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
PAYMENTS_PROVIDER=console

# --- Observability ------------------------------------------------------
LOG_LEVEL=debug
OTEL_ENABLED=false
